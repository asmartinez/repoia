NODE_ENV=production
PUBLIC_ORIGIN=https://repositorio.colmex.mx
HOST=0.0.0.0
PORT=8080
GEMINI_API_KEY=replace-with-existing-key
GEMINI_MODEL=gemini-2.5-flash
SESSION_SECRET=replace-with-at-least-32-random-characters
PROXY_TOKEN=replace-with-another-32-random-character-secret
STATE_DB=/app/data/state.sqlite
GEMINI_DAILY_CALL_LIMIT=500
GEMINI_CALLS_PER_MINUTE=30
REQUESTS_PER_IP_10_MIN=20
REQUESTS_PER_MINUTE=60
MAX_CONCURRENT_REQUESTS=4
RELEASE_ID=1.1.0
